{% extends '@Forge/client/layout.html.twig' %}

{% block forge_title %}{{ '@forge.quote.request_title'|trans }}{% endblock %}
{% block forge_lead %}{{ '@forge.quote.request_lead'|trans }}{% endblock %}
{% block forge_class %}forge-quote-request{% endblock %}
{% block background %}45-degree-fabric-dark{% endblock %}

{% block forge_body %}
<section class="forge-form-card">
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'ga-form forge-form'}}) }}
        <div class="ga-form-row">
            {{ form_row(form.contactName) }}
            {{ form_row(form.email) }}
        </div>
        {{ form_row(form.title) }}
        {{ form_row(form.request) }}
        <button type="submit" class="forge-btn forge-btn-primary"><span>{{ '@forge.quote.send'|trans }}</span><svg width="13" height="10" viewBox="0 0 13 10" aria-hidden="true"><path d="M1,5 L11,5"></path><polyline points="8 1 12 5 8 9"></polyline></svg></button>
    {{ form_end(form) }}
</section>
{% endblock %}
